load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

# -I$(ANDROID_BUILD_TOP)/motorola/kernel/modules/include
ddk_headers(
    name = "public_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
)

# -I$(ANDROID_BUILD_TOP)/motorola/kernel/modules/include/linux/input/awinic
ddk_headers(
    name = "awinic_headers",
    hdrs = glob(["include/linux/input/awinic/*.h"]),
    includes = ["include/linux/input/awinic"],
)
