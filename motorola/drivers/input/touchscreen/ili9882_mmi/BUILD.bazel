# Kleaf DDK translation of Kbuild, see motorola/moto_modules.bzl
load("//vendor/qcom/sm8450-modules/motorola:moto_modules.bzl", "moto_module")

moto_module(
    name = "ili9882_mmi",
    srcs = [
        "ili9882.c",
        "ili9882_spi.c",
        "ili9882_qcom.c",
        "ili9882_ic.c",
        "ili9882_touch.c",
        "ili9882_mp.c",
        "ili9882_hostdl.c",
        "ili9882_node.c",
    ] + glob(["**/*.h"]),
    # Always built against GKI (TARGET_BUILD_VARIANT=user)
    local_defines = [
        "GKI_EN_FLAG",
    ],
    # KBUILD_OPTIONS of the Makefile
    make_variables = [
        "CONFIG_INPUT_TOUCHSCREEN_MMI",
        "CONFIG_DRM_PANEL_EVENT_NOTIFICATIONS",
        "CONFIG_BOARD_USES_DOUBLE_TAP_CTRL",
        "CONFIG_INPUT_ILI_0FLASH_MMI_NOTIFY_TOUCH_STATE",
